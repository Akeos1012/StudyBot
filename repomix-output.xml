/* ============================================
   QUESTION CARD - PREMIUM
   ============================================ */
.sb-question-card {
  background: linear-gradient(145deg, rgba(24, 26, 32, 0.8), rgba(16, 17, 22, 0.6));
  border-radius: var(--radius-lg);
  padding: 24px;
  border: 1px solid rgba(42, 45, 54, 0.15);
  transition: all 0.2s ease;
  position: relative;
  overflow: hidden;
  animation: fadeSlideUp 0.4s ease forwards;
}

.sb-question-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(139, 124, 246, 0.15), transparent);
}

.sb-question-card:hover {
  border-color: rgba(42, 45, 54, 0.3);
  box-shadow: var(--shadow-glow);
}

.sb-question-card::after {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 200px;
  height: 200px;
  background: radial-gradient(circle, rgba(139, 124, 246, 0.02), transparent 70%);
  pointer-events: none;
}

.sb-question-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14px;
}

.sb-question-number {
  font-size: 11px;
  font-weight: 700;
  color: var(--text-muted);
  letter-spacing: 0.05em;
  text-transform: uppercase;
  background: rgba(42, 45, 54, 0.2);
  padding: 2px 12px;
  border-radius: 12px;
  border: 1px solid rgba(42, 45, 54, 0.1);
}

.sb-question-badge {
  font-size: 11px;
  font-weight: 600;
  padding: 3px 14px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  gap: 6px;
}

.sb-question-badge--correct {
  background: rgba(16, 185, 129, 0.12);
  color: #10b981;
  border: 1px solid rgba(16, 185, 129, 0.15);
}

.sb-question-badge--incorrect {
  background: rgba(244, 63, 94, 0.12);
  color: #f43f5e;
  border: 1px solid rgba(244, 63, 94, 0.15);
}

.sb-question-text {
  font-size: 16px;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.7;
  margin-bottom: 20px;
  letter-spacing: -0.01em;
}

/* ============================================
   OPTIONS - PREMIUM
   ============================================ */
.sb-options-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.sb-option-btn {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 12px 16px;
  background: rgba(16, 17, 22, 0.6);
  border: 1px solid rgba(42, 45, 54, 0.2);
  border-radius: var(--radius-sm);
  color: var(--text-secondary);
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.15s ease;
  text-align: left;
  position: relative;
  overflow: hidden;
}

.sb-option-btn:hover:not(:disabled) {
  background: rgba(42, 45, 54, 0.3);
  border-color: rgba(42, 45, 54, 0.4);
  transform: translateY(-1px);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
}

.sb-option-btn:disabled {
  cursor: not-allowed;
  opacity: 0.7;
}

.sb-option-btn--selected {
  background: rgba(139, 124, 246, 0.12);
  border-color: rgba(139, 124, 246, 0.3);
  color: var(--text-primary);
  box-shadow: 0 0 24px rgba(139, 124, 246, 0.05);
}

.sb-option-btn--selected::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(139, 124, 246, 0.05), transparent);
}

.sb-option-btn--correct {
  background: rgba(16, 185, 129, 0.12);
  border-color: rgba(16, 185, 129, 0.3);
  color: #10b981;
}

.sb-option-btn--wrong {
  background: rgba(244, 63, 94, 0.12);
  border-color: rgba(244, 63, 94, 0.3);
  color: #f43f5e;
}

.sb-option-btn--reveal {
  background: rgba(16, 185, 129, 0.05);
  border-color: rgba(16, 185, 129, 0.15);
}

.sb-option-letter {
  font-size: 12px;
  font-weight: 700;
  color: var(--text-muted);
  min-width: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(42, 45, 54, 0.2);
  border-radius: 6px;
  padding: 2px 0;
  flex-shrink: 0;
}

.sb-option-btn--selected .sb-option-letter {
  color: var(--accent-primary);
  background: rgba(139, 124, 246, 0.1);
}

.sb-option-btn--correct .sb-option-letter {
  color: #10b981;
  background: rgba(16, 185, 129, 0.1);
}

.sb-option-btn--wrong .sb-option-letter {
  color: #f43f5e;
  background: rgba(244, 63, 94, 0.1);
}

.sb-option-text {
  flex: 1;
  word-break: break-word;
  font-weight: 500;
}

/* ============================================
   FILL IN THE BLANK - PREMIUM
   ============================================ */
.sb-fill-container {
  display: flex;
  flex-direction: column;
  gap: 12px;
  max-width: 500px;
}

.sb-fill-input {
  background: rgba(16, 17, 22, 0.6);
  border: 1px solid rgba(42, 45, 54, 0.2);
  border-radius: var(--radius-sm);
  padding: 12px 16px;
  color: var(--text-primary);
  font-size: 14px;
  font-weight: 500;
  outline: none;
  transition: all 0.15s ease;
  width: 100%;
  font-family: var(--font-family);
}

.sb-fill-input:focus:not(:disabled) {
  border-color: rgba(139, 124, 246, 0.4);
  box-shadow: 0 0 0 4px rgba(139, 124, 246, 0.05);
  background: rgba(16, 17, 22, 0.8);
}

.sb-fill-input:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.sb-fill-input::placeholder {
  color: var(--text-muted);
  font-weight: 400;
}

.sb-fill-feedback {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 8px 12px;
  background: rgba(16, 185, 129, 0.05);
  border-radius: var(--radius-sm);
  border-left: 2px solid rgba(16, 185, 129, 0.3);
}

.sb-fill-correct-answer {
  font-size: 13px;
  color: #10b981;
  font-weight: 500;
}

/* ============================================
   RESPONSIVE
   ============================================ */
@media (max-width: 768px) {
  .sb-question-card {
    padding: 18px 16px;
    border-radius: var(--radius-md);
  }
  
  .sb-options-grid {
    grid-template-columns: 1fr;
    gap: 8px;
  }
  
  .sb-question-text {
    font-size: 15px;
  }
  
  .sb-option-btn {
    padding: 10px 14px;
    font-size: 12px;
  }
  
  .sb-fill-input {
    max-width: 100%;
    font-size: 13px;
  }
}
</file>

