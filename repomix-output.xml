            )

            print("RESULT:", question)
            print("==============================\n")
            if question:

                if attempt == 0:
                    metrics = get_metrics()
                    if metrics:
                        metrics.accepted_first_try += 1
                else:
                    metrics = get_metrics()
                    if metrics:
                        metrics.accepted_after_retry += 1

