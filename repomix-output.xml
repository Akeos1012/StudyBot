        except Exception:
            traceback.print_exc()
            raise

# HIGH LEVEL GENERATION ENTRY POINT
#
# Called by:
# quiz_service.py
#
# RESPONSIBILITY:
# Generate requested number of questions for a topic.
#
# FLOW:
#
# Topic
#  |
#  v
# Fact list
#  |
#  v
# generate_with_retry()
#  |
#  v
# validate
#  |
#  v
# cache
#  |
#  v
